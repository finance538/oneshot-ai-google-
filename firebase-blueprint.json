{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching auth.uid" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "role": { "type": "string", "description": "User role: merchant, admin, customer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "Customer SAR digital wallet balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner user ID" },
        "balance": { "type": "number", "description": "Wallet balance in SAR" },
        "currency": { "type": "string", "description": "SAR currency code" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["userId", "balance", "currency", "updatedAt"]
    },
    "WalletOrder": {
      "title": "WalletOrder",
      "description": "Purchased service order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order UUID" },
        "userId": { "type": "string", "description": "Customer user ID" },
        "sku": { "type": "string", "description": "Service SKU code" },
        "title": { "type": "string", "description": "Service package title" },
        "amount": { "type": "number", "description": "Order amount in SAR" },
        "status": { "type": "string", "description": "Order status: fulfilled, pending, processing" },
        "billingCycle": { "type": "string", "description": "one_time or monthly" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerEmail": { "type": "string", "description": "Customer email" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Order timestamp" }
      },
      "required": ["id", "userId", "sku", "title", "amount", "status", "createdAt"]
    },
    "WalletLedger": {
      "title": "WalletLedger",
      "description": "Credit and debit ledger entries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Entry UUID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "amount": { "type": "number", "description": "Transaction amount in SAR" },
        "description": { "type": "string", "description": "Transaction note or gateway description" },
        "isCredit": { "type": "boolean", "description": "True for topups, false for debits" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Entry timestamp" }
      },
      "required": ["id", "userId", "amount", "description", "isCredit", "createdAt"]
    },
    "PaymentDocument": {
      "title": "PaymentDocument",
      "description": "Payment requests and merchant invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Document UUID" },
        "userId": { "type": "string", "description": "Merchant owner user ID" },
        "title": { "type": "string", "description": "Payment request title" },
        "customerName": { "type": "string", "description": "Customer name" },
        "customerEmail": { "type": "string", "description": "Customer email" },
        "amount": { "type": "number", "description": "Amount in SAR" },
        "method": { "type": "string", "description": "hosted, framed, managed, recurring, invoice" },
        "gateway": { "type": "string", "description": "paytabs or telr" },
        "status": { "type": "string", "description": "paid, pending, review, cancelled" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Created timestamp" }
      },
      "required": ["id", "userId", "title", "customerName", "customerEmail", "amount", "method", "gateway", "status", "createdAt"]
    },
    "OpenLink": {
      "title": "OpenLink",
      "description": "Reusable open paylinks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Open link UUID" },
        "userId": { "type": "string", "description": "Merchant owner user ID" },
        "title": { "type": "string", "description": "Link label" },
        "minimum": { "type": "number", "description": "Minimum allowed amount" },
        "maximum": { "type": "number", "description": "Maximum allowed amount" },
        "enabled": { "type": "boolean", "description": "Active state" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Created timestamp" }
      },
      "required": ["id", "userId", "title", "minimum", "maximum", "enabled", "createdAt"]
    },
    "DelegatedTask": {
      "title": "DelegatedTask",
      "description": "Tasks assigned to C-Suite AI Agents",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Task UUID" },
        "userId": { "type": "string", "description": "Merchant owner user ID" },
        "agentId": { "type": "string", "description": "agent_ceo, agent_cfo, agent_cmo, agent_coo" },
        "title": { "type": "string", "description": "Task description" },
        "status": { "type": "string", "description": "completed, in_progress, pending" },
        "output": { "type": "string", "description": "Agent analysis or deliverable output" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "agentId", "title", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/wallet/data": {
      "schema": { "$ref": "#/entities/UserWallet" },
      "description": "User digital wallet document"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/WalletOrder" },
      "description": "Purchased orders for this user"
    },
    "/users/{userId}/ledger/{entryId}": {
      "schema": { "$ref": "#/entities/WalletLedger" },
      "description": "Wallet transaction ledger records"
    },
    "/payment_documents/{docId}": {
      "schema": { "$ref": "#/entities/PaymentDocument" },
      "description": "Payment documents and invoices created by merchants"
    },
    "/open_links/{linkId}": {
      "schema": { "$ref": "#/entities/OpenLink" },
      "description": "Reusable open payment links created by merchants"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/DelegatedTask" },
      "description": "CEO suite delegated tasks"
    }
  }
}
