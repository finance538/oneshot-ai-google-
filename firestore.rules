rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helpers
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserWallet(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.balance is number && data.balance >= 0 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWalletOrder(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.sku is string && data.sku.size() <= 50 &&
             data.title is string && data.title.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             data.status is string && data.status.size() <= 50 &&
             (!('billingCycle' in data) || (data.billingCycle is string && data.billingCycle.size() <= 50)) &&
             (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
             (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 150)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidWalletLedger(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.amount is number &&
             data.description is string && data.description.size() <= 300 &&
             data.isCredit is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPaymentDocument(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerEmail is string && data.customerEmail.size() <= 150 &&
             data.amount is number && data.amount > 0 &&
             data.method is string && data.method.size() <= 50 &&
             data.gateway is string && data.gateway.size() <= 50 &&
             data.status is string && data.status.size() <= 50 &&
             (!('interval' in data) || (data.interval is string && data.interval.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidOpenLink(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.minimum is number && data.minimum >= 0 &&
             data.maximum is number && data.maximum >= data.minimum &&
             data.enabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDelegatedTask(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.agentId is string && data.agentId.size() <= 50 &&
             data.title is string && data.title.size() <= 300 &&
             data.status is string && data.status.size() <= 50 &&
             (!('output' in data) || (data.output is string && data.output.size() <= 5000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Collection matches

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Profiles are strictly 1:1, never queried across users
      allow create: if isOwner(userId) &&
                       incoming().id == userId &&
                       isValidUserProfile(incoming());
      allow update: if isOwner(userId) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role']);
      allow delete: if false;

      // Nested User Wallet
      match /wallet/data {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create, update: if isOwner(userId) && isValidUserWallet(incoming());
        allow delete: if false;
      }

      // Nested Orders
      match /orders/{orderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWalletOrder(incoming());
        allow update: if isOwner(userId) &&
                         incoming().id == existing().id &&
                         incoming().createdAt == existing().createdAt &&
                         isValidWalletOrder(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        allow delete: if false;
      }

      // Nested Ledger
      match /ledger/{entryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWalletLedger(incoming());
        allow update, delete: if false; // Ledger entries are immutable
      }
    }

    // Payment Documents & Invoices
    match /payment_documents/{docId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidPaymentDocument(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPaymentDocument(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'title']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Reusable Open Payment Links
    match /open_links/{linkId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidOpenLink(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidOpenLink(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'minimum', 'maximum', 'enabled']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Delegated Tasks for CEO Suite
    match /tasks/{taskId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       isValidDelegatedTask(incoming());
      allow update: if isSignedIn() &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidDelegatedTask(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'output']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
